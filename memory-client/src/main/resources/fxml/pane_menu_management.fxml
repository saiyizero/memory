<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/8.0.201"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.murong.ecp.tools.fx.controller.PaneMenuMngController"
      spacing="12" alignment="TOP_LEFT" style="-fx-padding: 20; -fx-background-color: white;">
    <children>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <children>
                <Label text="菜单管理" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                <Label text="仅管理员可配置各角色可见菜单，保存后该角色用户重新登录生效"
                       style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;" />
            </children>
        </HBox>

        <HBox spacing="8" alignment="CENTER_LEFT">
            <children>
                <Label text="角色:" />
                <ComboBox fx:id="roleCombo" prefWidth="160" />
                <Button fx:id="selectAllBtn" text="全选" />
                <Button fx:id="clearAllBtn" text="全不选" />
                <Button fx:id="saveBtn" text="保存"
                        style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;" />
                <Label fx:id="hintLabel" style="-fx-text-fill: #7f8c8d;" />
            </children>
        </HBox>

        <ScrollPane fx:id="menuScrollPane" fitToWidth="true" VBox.vgrow="ALWAYS"
                    style="-fx-background-color: transparent;">
            <content>
                <VBox fx:id="menuContainer" spacing="10" />
            </content>
        </ScrollPane>
    </children>
</VBox>
