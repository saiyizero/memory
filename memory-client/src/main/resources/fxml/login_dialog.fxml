<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" styleClass="login-dialog" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.murong.ecp.tools.fx.infrastructure.controller.LoginDialogController">
   <children>
      <Label fx:id="titleLabel" text="Memory 系统登录" styleClass="login-title">
         <font>
            <Font size="24.0" />
         </font>
         <VBox.margin>
            <Insets bottom="10.0" />
         </VBox.margin>
      </Label>
      
      <VBox alignment="CENTER" spacing="15.0" maxWidth="320.0">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label text="用户名:" minWidth="80.0" />
                  <TextField fx:id="usernameField" promptText="请输入用户名" HBox.hgrow="ALWAYS" />
               </children>
            </HBox>

            <HBox fx:id="realNameRow" alignment="CENTER_LEFT" spacing="10.0" visible="false" managed="false">
               <children>
                  <Label text="真实姓名:" minWidth="80.0" />
                  <TextField fx:id="realNameField" promptText="请输入真实姓名" HBox.hgrow="ALWAYS" />
               </children>
            </HBox>

            <HBox fx:id="emailRow" alignment="CENTER_LEFT" spacing="10.0" visible="false" managed="false">
               <children>
                  <Label text="邮箱:" minWidth="80.0" />
                  <TextField fx:id="emailField" promptText="请输入邮箱" HBox.hgrow="ALWAYS" />
               </children>
            </HBox>

            <HBox fx:id="phoneRow" alignment="CENTER_LEFT" spacing="10.0" visible="false" managed="false">
               <children>
                  <Label text="电话:" minWidth="80.0" />
                  <TextField fx:id="phoneField" promptText="请输入电话" HBox.hgrow="ALWAYS" />
               </children>
            </HBox>
            
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label text="密码:" minWidth="80.0" />
                  <PasswordField fx:id="passwordField" promptText="请输入密码" HBox.hgrow="ALWAYS" />
               </children>
            </HBox>

            <HBox fx:id="confirmPasswordRow" alignment="CENTER_LEFT" spacing="10.0" visible="false" managed="false">
               <children>
                  <Label text="确认密码:" minWidth="80.0" />
                  <PasswordField fx:id="confirmPasswordField" promptText="请再次输入密码" HBox.hgrow="ALWAYS" />
               </children>
            </HBox>
            
            <Label fx:id="messageLabel" text="" styleClass="login-message" textAlignment="CENTER" maxWidth="320.0" wrapText="true" />
            
            <HBox fx:id="loginButtonRow" alignment="CENTER" spacing="15.0">
               <children>
                  <Button fx:id="loginButton" text="登录" onAction="#handleLogin" styleClass="login-button" />
                  <Button fx:id="cancelButton" text="退出" onAction="#handleCancel" styleClass="cancel-button" />
               </children>
            </HBox>

            <HBox fx:id="registerButtonRow" alignment="CENTER" spacing="15.0" visible="false" managed="false">
               <children>
                  <Button fx:id="registerButton" text="注册" onAction="#handleRegister" styleClass="register-button" />
                  <Button fx:id="backToLoginButton" text="返回登录" onAction="#handleSwitchToLogin" styleClass="cancel-button" />
               </children>
            </HBox>
         </children>
      </VBox>

      <Hyperlink fx:id="switchModeLink" text="没有账号？立即注册" onAction="#handleSwitchToRegister" styleClass="login-switch-link" />
   </children>
   <padding>
      <Insets bottom="20.0" left="30.0" right="30.0" top="30.0" />
   </padding>
</VBox>
