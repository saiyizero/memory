<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.geometry.Insets?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" 
            prefHeight="638.75" prefWidth="951.25" style="-fx-background-color: white;" 
            xmlns="http://javafx.com/javafx/8.0.201" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.murong.ecp.tools.fx.controller.PaneBasicConfigController">
   <children>
      <VBox spacing="10" AnchorPane.topAnchor="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10" AnchorPane.bottomAnchor="10">
         <children>
            <!-- 标题 -->
            <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 10;">
               <children>
                  <Label text="基础配置管理" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                  <Label text="(状态为Y的记录)" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;" />
               </children>
            </HBox>
            
            <!-- 操作按钮区域 -->
            <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 10;">
               <children>
                  <Button fx:id="saveButton" text="保存" onAction="#saveData" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" />
                  <Button fx:id="resetButton" text="重置" onAction="#resetForm" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" />
               </children>
            </HBox>
            
            <!-- 表单区域 -->
            <GridPane hgap="10" vgap="10" style="-fx-background-color: #f8f9fa; -fx-padding: 15; -fx-background-radius: 5;" VBox.vgrow="ALWAYS">
               <columnConstraints>
                  <ColumnConstraints hgrow="NEVER" minWidth="100" prefWidth="120" />
                  <ColumnConstraints hgrow="ALWAYS" minWidth="200" prefWidth="250" />
                  <ColumnConstraints hgrow="NEVER" minWidth="100" prefWidth="120" />
                  <ColumnConstraints hgrow="ALWAYS" minWidth="200" prefWidth="250" />
               </columnConstraints>
               
               <children>

                  
                  <!-- 第一行 -->
                  <Label text="数据库用户名:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                  <TextField fx:id="dbUsrNameField" promptText="请输入数据库用户名" GridPane.columnIndex="1" GridPane.rowIndex="0" maxWidth="Infinity" />
                  
                  <Label text="数据库密码:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                  <PasswordField fx:id="dbPassWordField" promptText="请输入数据库密码" GridPane.columnIndex="3" GridPane.rowIndex="0" maxWidth="Infinity" />
                  
                  <!-- 第二行 -->
                  <Label text="数据库驱动:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                  <TextField fx:id="dbDriverNameField" promptText="请输入数据库驱动名称" GridPane.columnIndex="1" GridPane.rowIndex="1" maxWidth="Infinity" />
                  <Label text="服务地址:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                  <TextField fx:id="dbUrlField" promptText="如: http://localhost:8080" GridPane.columnIndex="3" GridPane.rowIndex="1" maxWidth="Infinity" />
                  
                  <!-- 第三行 -->
                  <Label text="翻译服务URL:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                  <TextField fx:id="translateUrlField" promptText="请输入翻译服务URL" GridPane.columnIndex="1" GridPane.rowIndex="2" maxWidth="Infinity" />
                  
                  <Label text="翻译访问密钥:" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                  <TextField fx:id="translateAccessField" promptText="请输入翻译访问密钥" GridPane.columnIndex="3" GridPane.rowIndex="2" maxWidth="Infinity" />
                  
                  <!-- 第四行 -->
                  <Label text="翻译令牌:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                  <TextField fx:id="translateTokenField" promptText="请输入翻译令牌" GridPane.columnIndex="1" GridPane.rowIndex="3" maxWidth="Infinity" />
               </children>
            </GridPane>
            

         </children>
      </VBox>
   </children>
</AnchorPane>
