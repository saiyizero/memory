<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox fx:id="licensePane" spacing="10" styleClass="license-pane" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.murong.ecp.tools.fx.controller.PaneLicenseController">
   <children>
      <Label text="许可证管理" styleClass="title-label">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      
      <Separator />
      
      <GridPane hgap="10" vgap="10">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="150.0" />
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="300.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <Label text="许可证状态:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <Label fx:id="lblLicenseStatus" text="未安装" GridPane.columnIndex="1" GridPane.rowIndex="0" style="-fx-text-fill: orange; -fx-font-weight: bold;" />
            
            <Label text="公司名称:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <Label fx:id="lblCompanyName" text="未安装" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            
            <Label text="产品名称:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <Label fx:id="lblProductName" text="未安装" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            
            <Label text="版本:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
            <Label fx:id="lblVersion" text="未安装" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            
            <Label text="过期时间:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
            <Label fx:id="lblExpireDate" text="未安装" GridPane.columnIndex="1" GridPane.rowIndex="4" />
            
            <Label text="功能特性:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
            <Label fx:id="lblFeatures" text="未安装" GridPane.columnIndex="1" GridPane.rowIndex="5" />
            
            <Label text="最低版本:" GridPane.columnIndex="0" GridPane.rowIndex="6" />
            <Label fx:id="lblMinVersion" text="未安装" GridPane.columnIndex="1" GridPane.rowIndex="6" />
            
            <Label text="最高版本:" GridPane.columnIndex="0" GridPane.rowIndex="7" />
            <Label fx:id="lblMaxVersion" text="未安装" GridPane.columnIndex="1" GridPane.rowIndex="7" />
         </children>
      </GridPane>
      
      <Separator />
      
      <HBox spacing="10" alignment="CENTER">
         <children>
            <Button fx:id="btnInstallLicense" text="安装许可证" onAction="#installLicense" />
            <Button fx:id="btnShowCurrentVersion" text="显示当前版本" onAction="#showCurrentVersion" />
            <Button fx:id="btnRefreshLicense" text="刷新信息" onAction="#refreshLicenseInfo" />
         </children>
      </HBox>
      
      <VBox spacing="5" styleClass="info-box">
         <children>
            <Label text="使用说明:" styleClass="subtitle-label" />
            <Label text="1. 点击'显示当前版本'查看应用版本信息" />
            <Label text="2. 联系软件供应商获取对应版本的许可证" />
            <Label text="3. 点击'安装许可证'选择许可证文件进行安装" />
            <Label text="4. 许可证过期或版本不匹配时需要升级应用" />
         </children>
      </VBox>
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</VBox> 