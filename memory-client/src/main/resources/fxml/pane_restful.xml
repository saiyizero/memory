<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<SplitPane orientation="HORIZONTAL" dividerPositions="0.73" xmlns="http://javafx.com/javafx/8.0.201" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.murong.ecp.tools.fx.controller.PanRestFulController" VBox.vgrow="ALWAYS">
    <items>
        <!-- 左侧主内容区，原VBox内容整体缩进 -->
        <VBox spacing="16" style="-fx-padding: 18 24 18 24;" alignment="TOP_LEFT" VBox.vgrow="ALWAYS">
            <!-- 顶部信息区用GridPane实现左对齐 -->
            <GridPane hgap="10" vgap="10">
                <Label text="接口：" style="-fx-font-weight: bold; -fx-font-size: 16;" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                <Label fx:id="transNameField" style="-fx-font-size: 16;" GridPane.rowIndex="0" GridPane.columnIndex="1" />
                <Label text="说明：" style="-fx-font-weight: bold; -fx-font-size: 16;" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                <Label fx:id="transCommentZhLabel" text="" style="-fx-font-size: 16" GridPane.rowIndex="1" GridPane.columnIndex="1" />
            </GridPane>
            <GridPane hgap="10" vgap="10">
                <ComboBox fx:id="methodComboBox" prefWidth="80" GridPane.rowIndex="2" GridPane.columnIndex="1" />
                <ComboBox fx:id="ipComboBox" promptText="选择IP地址" prefWidth="190" GridPane.rowIndex="2" GridPane.columnIndex="2" />
                <TextField fx:id="urlField" promptText="接口URL" prefWidth="280" GridPane.rowIndex="2" GridPane.columnIndex="3" />
                <Button fx:id="sendButton" text="发送" style="-fx-background-color: #1677ff; -fx-text-fill: white;" GridPane.rowIndex="2" GridPane.columnIndex="4" onAction="#onSend" />
            </GridPane>
            <!-- TabPane 区域 -->
            <TabPane fx:id="mainTabPane" VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE">
                <tabs>
                    <Tab text="请求头">
                        <VBox spacing="10" alignment="TOP_LEFT" style="-fx-padding: 10 0 0 0;">
                            <TableView fx:id="headerTable" prefHeight="120">
                                <columns>
                                    <TableColumn text="参数名" fx:id="headerNameCol" prefWidth="180" />
                                    <TableColumn text="参数值" fx:id="headerValueCol" prefWidth="220" />
                                    <TableColumn text="操作" fx:id="headerActionCol" prefWidth="60" />
                                </columns>
                            </TableView>
                            <Button fx:id="addHeaderBtn" text="添加请求头" />
                        </VBox>
                    </Tab>
                    <Tab text="请求参数" closable="false" fx:id="requestParamTab">
                        <TreeTableView fx:id="requestTable" VBox.vgrow="ALWAYS" editable="true" styleClass="custom-tree-table">
                            <columns>
                                <TreeTableColumn fx:id="reqParamNameColumn" prefWidth="150.0" text="参数名"/>
                                <TreeTableColumn fx:id="reqParamTypeColumn" prefWidth="55.0" text="类型"/>
                                <TreeTableColumn fx:id="reqParamLengthColumn" prefWidth="35.0" text="长度"/>
                                <TreeTableColumn fx:id="reqParamValueColumn" prefWidth="200.0" text="参数值"/>
                                <TreeTableColumn fx:id="reqParamRemarkColumn" prefWidth="200.0" text="描述"/>
                            </columns>
                        </TreeTableView>
                    </Tab>
                    <Tab text="公共参数" closable="false" fx:id="commonParamTab">
                        <TreeTableView fx:id="commonParamTable" VBox.vgrow="ALWAYS" editable="true" styleClass="custom-tree-table">
                            <columns>
                                <TreeTableColumn fx:id="commonParamNameColumn" prefWidth="150.0" text="参数名"/>
                                <TreeTableColumn fx:id="commonParamTypeColumn" prefWidth="55.0" text="类型"/>
                                <TreeTableColumn fx:id="commonParamLengthColumn" prefWidth="35.0" text="长度"/>
                                <TreeTableColumn fx:id="commonParamValueColumn" prefWidth="200.0" text="参数值"/>
                                <TreeTableColumn fx:id="commonParamRemarkColumn" prefWidth="200.0" text="描述"/>
                            </columns>
                        </TreeTableView>
                    </Tab>
                    <Tab text="响应参数" closable="false">
                        <TreeTableView fx:id="responseTable" VBox.vgrow="ALWAYS" editable="true" styleClass="custom-tree-table">
                            <columns>
                                <TreeTableColumn fx:id="respParamNameColumn" prefWidth="150.0" text="参数名"/>
                                <TreeTableColumn fx:id="respParamTypeColumn" prefWidth="55.0" text="类型"/>
                                <TreeTableColumn fx:id="respParamLengthColumn" prefWidth="35.0" text="长度"/>
                                <TreeTableColumn fx:id="respParamValueColumn" prefWidth="200.0" text="参数值"/>
                                <TreeTableColumn fx:id="respParamRemarkColumn" prefWidth="200.0" text="描述"/>
                            </columns>
                        </TreeTableView>
                    </Tab>
                </tabs>
            </TabPane>
        </VBox>
        <!-- 右侧菜单栏 -->
        <VBox fx:id="rightMenuBar" alignment="TOP_CENTER" spacing="8" style="-fx-background-color: #f7f7f7; -fx-padding: 12 8;">
            <HBox spacing="6" alignment="CENTER_LEFT">
                <TextField fx:id="caseFilterField" promptText="筛选测试案例..." HBox.hgrow="ALWAYS" />
                <Button fx:id="caseQueryButton" text="查询" />
            </HBox>
            <HBox spacing="8" alignment="CENTER">
                <Button fx:id="detailButton" text="详情" />
                <Button fx:id="logButton" text="日志" />
                <Button fx:id="importJsonButton" text="导入JSON" onAction="#onImportJson" />
                <Button fx:id="exportHttpButton" text="导出http" onAction="#onExportHttp" />
            </HBox>
            <ListView fx:id="caseListView" VBox.vgrow="ALWAYS" />
        </VBox>
    </items>
</SplitPane>
