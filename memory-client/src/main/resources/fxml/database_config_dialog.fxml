<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.TextAlignment?>

<VBox alignment="CENTER" spacing="0.0" styleClass="login-dialog" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.murong.ecp.tools.fx.infrastructure.controller.DatabaseConfigDialogController">
   <padding>
      <Insets top="30.0" right="40.0" bottom="30.0" left="40.0" />
   </padding>
   <children>
      <Label text="服务连接配置" styleClass="login-title">
         <font>
            <Font size="24.0" />
         </font>
         <VBox.margin>
            <Insets bottom="30.0" />
         </VBox.margin>
      </Label>
      
      <VBox alignment="CENTER" spacing="20.0" maxWidth="450.0" minWidth="450.0">
         <children>
            <VBox alignment="CENTER_LEFT" spacing="8.0">
               <children>
                  <Label text="memory-service 地址:" styleClass="field-label" />
                  <TextField fx:id="dbUrlField" promptText="如: http://localhost:8080" styleClass="config-field" />
               </children>
            </VBox>
            
            <Label fx:id="messageLabel" text="" styleClass="login-message" textAlignment="CENTER" maxWidth="450.0" wrapText="true">
               <VBox.margin>
                  <Insets top="20.0" />
               </VBox.margin>
            </Label>
            
            <HBox alignment="CENTER" spacing="15.0">
               <VBox.margin>
                  <Insets top="25.0" />
               </VBox.margin>
               <children>
                  <Button fx:id="testConnectionButton" text="测试连接" onAction="#handleTestConnection" styleClass="login-button" prefWidth="100.0" />
                  <Button fx:id="saveButton" text="保存配置" onAction="#handleSave" styleClass="login-button" prefWidth="100.0" />
                  <Button fx:id="cancelButton" text="取消" onAction="#handleCancel" styleClass="cancel-button" prefWidth="80.0" />
               </children>
            </HBox>
         </children>
      </VBox>
      
      <Label text="请配置 memory-service 的 HTTP 地址，客户端将通过该地址访问远程数据库" styleClass="login-hint" textAlignment="CENTER" maxWidth="450.0" wrapText="true">
         <VBox.margin>
            <Insets top="25.0" />
         </VBox.margin>
      </Label>
   </children>
</VBox>
