<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.SplitPane?>

<SplitPane dividerPositions="0.65" xmlns="http://javafx.com/javafx/8.0.201" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.murong.ecp.tools.fx.controller.PaneServerMngController"
           prefWidth="1200.0" prefHeight="700.0">
    <items>
        <!-- 左边服务器列表区域 -->
        <VBox spacing="10" style="-fx-padding: 10;" alignment="TOP_LEFT">
            <!-- 顶部控制区域 -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="环境:" />
                <ComboBox fx:id="environmentCombo" prefWidth="100" />
                <Label text="微服务:" />
                <ComboBox fx:id="searchMicroServiceCombo" promptText="请选择" prefWidth="120" />
                <Button fx:id="addMicroServiceBtn" text="添加微服务" />
                <Button fx:id="addServerBtn" text="同步服务器" />
            </HBox>
            
            <!-- 服务器列表 -->
            <ScrollPane fitToWidth="true" fitToHeight="false" VBox.vgrow="ALWAYS">
                <content>
                    <VBox fx:id="serverConfigVBox" spacing="10" />
                </content>
            </ScrollPane>
        </VBox>
        
        <!-- 右边搜索和结果区域 -->
        <VBox spacing="10" style="-fx-padding: 10;">
            <!-- 搜索控制区域 -->
            <VBox spacing="8">
                <!-- 第一行：搜索类型、天数、清空按钮 -->
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="类型:" />
                    <ComboBox fx:id="searchTypeCombo" promptText="请选择" prefWidth="120" />
                    <Label text="天数:" />
                    <TextField fx:id="searchDayField" promptText="天数" prefWidth="40" />
                    <Label text="天" />
                    <HBox HBox.hgrow="ALWAYS" />
                    <Button fx:id="clearSearchBtn" text="清空" />
                </HBox>
                
                <!-- 第二行：搜索内容输入框和开始搜索按钮 -->
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="内容:" />
                    <TextField fx:id="searchContentField" promptText="请输入搜索内容" HBox.hgrow="ALWAYS"/>
                    <Button fx:id="searchBtn" text="搜索" />
                </HBox>
            </VBox>
            
            <!-- 搜索结果表格 - 添加ScrollPane支持横向滚动 -->
            <ScrollPane fitToHeight="true" fitToWidth="false" hbarPolicy="AS_NEEDED" vbarPolicy="NEVER" 
                       style="-fx-padding: 0;" VBox.vgrow="ALWAYS">
                <content>
                    <TableView fx:id="searchResultTable" />
                </content>
            </ScrollPane>
        </VBox>
    </items>
</SplitPane> 