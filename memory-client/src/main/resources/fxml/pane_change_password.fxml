<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="638.75" prefWidth="951.25" style="-fx-background-color: white;"
            xmlns="http://javafx.com/javafx/8.0.201" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.murong.ecp.tools.fx.controller.PaneChangePasswordController">
   <children>
      <VBox spacing="10" AnchorPane.topAnchor="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10" AnchorPane.bottomAnchor="10">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 10;">
               <children>
                  <Label text="修改密码" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                  <Label text="修改前需校验原密码" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;" />
               </children>
            </HBox>

            <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 10;">
               <children>
                  <Button fx:id="saveButton" text="保存" onAction="#savePassword" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" />
                  <Button fx:id="resetButton" text="重置" onAction="#resetForm" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" />
               </children>
            </HBox>

            <GridPane hgap="10" vgap="12" style="-fx-background-color: #f8f9fa; -fx-padding: 15; -fx-background-radius: 5;">
               <columnConstraints>
                  <ColumnConstraints hgrow="NEVER" minWidth="100" prefWidth="120" />
                  <ColumnConstraints hgrow="ALWAYS" minWidth="220" prefWidth="320" />
               </columnConstraints>

               <children>
                  <Label text="当前用户:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                  <Label fx:id="currentUserLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="0"
                         style="-fx-text-fill: #2c3e50; -fx-font-weight: bold;" />

                  <Label text="原密码:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                  <PasswordField fx:id="oldPasswordField" promptText="请输入原密码" GridPane.columnIndex="1" GridPane.rowIndex="1" maxWidth="360" />

                  <Label text="新密码:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                  <PasswordField fx:id="newPasswordField" promptText="请输入新密码" GridPane.columnIndex="1" GridPane.rowIndex="2" maxWidth="360" />

                  <Label text="确认新密码:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                  <PasswordField fx:id="confirmPasswordField" promptText="请再次输入新密码" GridPane.columnIndex="1" GridPane.rowIndex="3" maxWidth="360" />
               </children>
            </GridPane>
         </children>
      </VBox>
   </children>
</AnchorPane>
