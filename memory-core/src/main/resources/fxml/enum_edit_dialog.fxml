<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
      spacing="7" styleClass="dialog-pane" stylesheets="@../css/main.css">
    
    <padding>
        <Insets top="10" right="15" bottom="10" left="15"/>
    </padding>
    
    <!-- 标题区域 -->
    <HBox spacing="7" alignment="CENTER_LEFT">
        <Label text="枚举选择对话框" 
               styleClass="dialog-title" 
               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #333;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="refreshButton" text="刷新" 
                styleClass="secondary-button"/>
    </HBox>
    
    <Separator/>
    
    <!-- 主要内容区域 - 左右分栏 -->
    <HBox fx:id="mainContentHBox" spacing="20" VBox.vgrow="ALWAYS">
        
        <!-- 左侧：枚举类型列表 -->
        <VBox fx:id="leftVBox" spacing="8" minWidth="256" prefWidth="336" maxWidth="480" 
              style="-fx-padding: 0 5 0 0;">
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="枚举类型列表" style="-fx-font-weight: bold; -fx-text-fill: #555; -fx-font-size: 13px;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="clearButton" text="清空" 
                        styleClass="secondary-button" 
                        style="-fx-font-size: 11px; -fx-padding: 3 6;"/>
            </HBox>
            
            <!-- 搜索过滤区域 -->
            <HBox spacing="6" alignment="CENTER_LEFT">
                <Label text="搜索:" style="-fx-text-fill: #666; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                <TextField fx:id="filterField" 
                          promptText="输入枚举名称进行搜索"
                          styleClass="form-field"
                          HBox.hgrow="ALWAYS"/>
            </HBox>
            
            <!-- 枚举类型表格 -->
            <TableView fx:id="enumTypeTableView" VBox.vgrow="ALWAYS" 
                      style="-fx-background-color: #fafafa; -fx-border-color: #e0e0e0; -fx-border-width: 1px; -fx-border-radius: 3px;">
                <columns>
                    <TableColumn fx:id="appNameColumn" text="归属" prefWidth="60"/>
                    <TableColumn fx:id="enumNmeColumn" text="枚举名称" prefWidth="90"/>
                    <TableColumn fx:id="dbNameColumn" text="DB名称" prefWidth="90"/>
                </columns>
            </TableView>
            
            <!-- 操作提示 -->
            <Label text="双击左侧记录可快速选择并关闭对话框" 
                   style="-fx-text-fill: #666; -fx-font-size: 10px; -fx-font-style: italic; -fx-alignment: center; -fx-padding: 3 0;"/>
        </VBox>
        
        <!-- 可拖拽的分隔线 -->
        <Separator fx:id="resizeSeparator" orientation="VERTICAL" 
                   style="-fx-background-color: #ddd; -fx-pref-width: 6px; -fx-cursor: h-resize; -fx-background-radius: 3px;"/>
        
        <!-- 右侧：枚举项详情（只读） -->
        <VBox fx:id="rightVBox" spacing="8" HBox.hgrow="ALWAYS" minWidth="256" 
              style="-fx-padding: 0 0 0 5;">
            <Label text="枚举项详情" style="-fx-font-weight: bold; -fx-text-fill: #555; -fx-font-size: 13px;"/>
            
            <!-- 枚举基本信息 -->
            <GridPane hgap="12" vgap="7" style="-fx-padding: 6 0;">
                <columnConstraints>
                    <ColumnConstraints hgrow="NEVER" minWidth="64" prefWidth="80"/>
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="120" prefWidth="160"/>
                    <ColumnConstraints hgrow="NEVER" minWidth="64" prefWidth="80"/>
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="120" prefWidth="160"/>
                </columnConstraints>
                
                <Label text="枚举名称:" GridPane.columnIndex="0" GridPane.rowIndex="0" 
                       style="-fx-font-weight: bold; -fx-text-fill: #555; -fx-font-size: 11px;"/>
                <TextField fx:id="enumNmeField" GridPane.columnIndex="1" GridPane.rowIndex="0"
                          promptText="枚举名称" editable="false" 
                          style="-fx-background-color: #f8f8f8; -fx-border-color: #e0e0e0; -fx-border-width: 1px; -fx-border-radius: 3px;"/>
                
                <Label text="数据库名称:" GridPane.columnIndex="2" GridPane.rowIndex="0" 
                       style="-fx-font-weight: bold; -fx-text-fill: #555; -fx-font-size: 11px;"/>
                <TextField fx:id="dbNameField" GridPane.columnIndex="3" GridPane.rowIndex="0"
                          promptText="数据库名称" editable="false"
                          style="-fx-background-color: #f8f8f8; -fx-border-color: #e0e0e0; -fx-border-width: 1px; -fx-border-radius: 3px;"/>
            </GridPane>
            
            <!-- 枚举项表格说明 -->
            <Label text="枚举项列表（只读显示）" 
                   style="-fx-text-fill: #666; -fx-font-size: 10px; -fx-font-style: italic; -fx-padding: 3 0;"/>
            
            <!-- 枚举项表格 -->
            <TableView fx:id="enumItemTable" VBox.vgrow="ALWAYS"
                      style="-fx-background-color: #fafafa; -fx-border-color: #e0e0e0; -fx-border-width: 1px; -fx-border-radius: 3px;">
                <columns>
                    <TableColumn fx:id="enumCdColumn" text="枚举代码" prefWidth="80"/>
                    <TableColumn fx:id="enumValColumn" text="枚举值" prefWidth="80"/>
                    <TableColumn fx:id="descCnItemColumn" text="中文描述" prefWidth="120"/>
                    <TableColumn fx:id="descEnItemColumn" text="英文描述" prefWidth="120"/>
                </columns>
            </TableView>
            
            <!-- 关闭按钮 -->
            <HBox spacing="8" alignment="CENTER_RIGHT" style="-fx-padding: 6 0 0 0;">
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="closeButton" text="关闭" 
                        styleClass="secondary-button"
                        style="-fx-font-size: 11px; -fx-padding: 4 10;"/>
            </HBox>
        </VBox>
        
    </HBox>
    
</VBox>
