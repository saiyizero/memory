<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.murong.ecp.tools.fx.controller.MainController">
    <left>
        <VBox fx:id="menuBar" styleClass="menu-bar">
            <!-- LOGO区 -->
            <VBox styleClass="menu-logo-area">
                <HBox styleClass="menu-logo-hbox">
                    <ImageView fx:id="logoImage" fitWidth="32" fitHeight="32" />
                    <Label text="Memory" styleClass="menu-logo-text" />
                </HBox>
            </VBox>
            <!-- 分组菜单容器，后续由代码动态生成分组和子菜单 -->
            <VBox fx:id="menuGroupContainer" styleClass="menu-group" />
        </VBox>
    </left>
    <center>
        <StackPane fx:id="mainContent" styleClass="main-content">
            <VBox>
                <HBox styleClass="main-banner" alignment="CENTER_LEFT" spacing="32">
                    <Button fx:id="toggleMenuBtn" styleClass="menu-toggle-btn" text="≡" minWidth="48" maxWidth="48" prefWidth="48" />
                    <VBox styleClass="header-combo-group" alignment="TOP_LEFT">
                        <ComboBox fx:id="envComboBox" styleClass="header-combobox" promptText="选择项目群" minWidth="120" maxWidth="160" prefWidth="140" />
                    </VBox>
                    <VBox styleClass="header-combo-group" alignment="TOP_LEFT">
                        <ComboBox fx:id="dsComboBox" styleClass="header-combobox" promptText="选择项目名称" minWidth="120" maxWidth="160" prefWidth="140" />
                    </VBox>
                    <Pane minWidth="60" maxWidth="180" prefWidth="120" />
                    <Pane fx:id="bannerContent" HBox.hgrow="ALWAYS" />
                    <!-- 用户信息区域 -->
                    <HBox styleClass="user-info-area" alignment="CENTER_RIGHT" spacing="12">
                        <Label fx:id="usernameLabel" text="用户" styleClass="username-label" />
                        <Button fx:id="logoutBtn" text="退出" styleClass="logout-btn" />
                    </HBox>
                </HBox>
                <TabPane fx:id="pageContainer" VBox.vgrow="ALWAYS" />
            </VBox>
        </StackPane>
    </center>
</BorderPane>
