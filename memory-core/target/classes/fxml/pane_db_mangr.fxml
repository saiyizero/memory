<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.murong.ecp.tools.fx.controller.PaneDbMngController" spacing="12" alignment="TOP_CENTER" style="-fx-padding: 18;">
    <HBox spacing="8" alignment="CENTER_LEFT">
        <Button fx:id="toggleSelectBtn" text="全选" />
        <Button fx:id="setEnvBtn" text="设置环境" />
        <Button fx:id="deleteBtn" text="删除" />
        <Button fx:id="addBtn" text="新增" />
        <Button fx:id="editBtn" text="编辑" />
        <ComboBox fx:id="envCombo" prefWidth="120" />
        <Button fx:id="importBtn" text="导入" />
    </HBox>
    <TableView fx:id="datasourceTable" prefHeight="400" prefWidth="700" editable="true" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="selectCol" text="选择" prefWidth="60" editable="true" />
            <TableColumn fx:id="appNameCol" text="微服务" prefWidth="160" />
            <TableColumn fx:id="schemaCol" text="schema" prefWidth="60" />
            <TableColumn fx:id="envCol" text="环境" prefWidth="50" />
            <TableColumn fx:id="usernameCol" text="用户名" prefWidth="120" />
            <TableColumn fx:id="passwordCol" text="密码" prefWidth="120" />
            <TableColumn fx:id="mainFlagCol" text="主库" prefWidth="50" editable="true" />
            <TableColumn fx:id="urlCol" text="数据库连接" prefWidth="300" />
            <TableColumn fx:id="driverCol" text="驱动名" prefWidth="170" />
        </columns>
    </TableView>
</VBox> 