<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<SplitPane dividerPositions="0.4" xmlns="http://javafx.com/javafx/8.0.201" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.murong.ecp.tools.fx.controller.PaneCommonObjController"
           prefWidth="900.0" prefHeight="600.0">
    <items>
        <VBox spacing="10" style="-fx-padding: 10;" alignment="TOP_LEFT">
            <HBox spacing="6" alignment="CENTER_LEFT">
                <TextField fx:id="filterField" promptText="筛选..." HBox.hgrow="ALWAYS"/>
                <Button fx:id="clearButton" text="清空"/>
                <Button fx:id="exportButton" text="导出数据"/>
            </HBox>
            <TableView fx:id="tableView" VBox.vgrow="ALWAYS" editable="true">
                <columns>
                    <TableColumn fx:id="selectColumn" text="" prefWidth="40"/>
                    <TableColumn fx:id="classNameColumn" text="类名" prefWidth="120"/>
                    <TableColumn fx:id="classTypeColumn" text="类类型" prefWidth="80"/>
                    <TableColumn fx:id="classPathColumn" text="类路径" prefWidth="150"/>
                    <TableColumn fx:id="appNameColumn" text="归属" prefWidth="60" style="-fx-alignment: center;"/>
                </columns>
            </TableView>
            <HBox spacing="6" alignment="CENTER_LEFT">
                <CheckBox fx:id="selectAllCheckBox" text="全选/全不选"/>
                <Button fx:id="deleteButton" text="删除选中" />
            </HBox>
        </VBox>
        <VBox spacing="10" style="-fx-padding: 10;">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="类名:"/>
                <TextField fx:id="classNameField" editable="false" prefWidth="150"/>
                <Label text="类类型:"/>
                <ComboBox fx:id="classTypeComboBox" prefWidth="120"/>
                <Button fx:id="saveButton" text="保存"/>
            </HBox>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="类路径:"/>
                <TextField fx:id="classPathField" prefWidth="300"/>
            </HBox>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="中文注释:"/>
                <TextField fx:id="classCommentCnField" prefWidth="200"/>
                <Label text="英文注释:"/>
                <TextField fx:id="classCommentEnField" prefWidth="200"/>
            </HBox>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="完成标志:"/>
                <TextField fx:id="completedFlgField" prefWidth="100"/>
            </HBox>
            
            <!-- 字段详情表格 -->
            <Label text="字段详情:" style="-fx-font-weight: bold; -fx-padding: 5 0 5 0;"/>
            <TableView fx:id="fieldsTable" VBox.vgrow="ALWAYS" editable="true">
                <columns>
                    <TableColumn fx:id="fieldNameColumn" text="字段名" prefWidth="120"/>
                    <TableColumn fx:id="fieldTypeColumn" text="类型" prefWidth="80"/>
                    <TableColumn fx:id="fieldDbTypeColumn" text="数据库类型" prefWidth="100"/>
                    <TableColumn fx:id="fieldLengthColumn" text="长度" prefWidth="60" style="-fx-alignment: center;"/>
                    <TableColumn fx:id="fieldNotNullColumn" text="非空" prefWidth="50" style="-fx-alignment: center;"/>
                    <TableColumn fx:id="fieldDefaultColumn" text="默认值" prefWidth="80"/>
                    <TableColumn fx:id="fieldCommentCnColumn" text="中文注释" prefWidth="120"/>
                    <TableColumn fx:id="fieldCommentEnColumn" text="英文注释" prefWidth="120"/>
                    <TableColumn fx:id="fieldDeleteColumn" text="操作" prefWidth="60"/>
                </columns>
            </TableView>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Button fx:id="addFieldButton" text="新增字段"/>
                <Button fx:id="deleteFieldButton" text="删除选中字段"/>
            </HBox>
        </VBox>
    </items>
</SplitPane> 