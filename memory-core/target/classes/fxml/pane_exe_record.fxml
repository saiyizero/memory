<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>
<VBox spacing="12.5" style="-fx-padding: 12.5 24 12.5 12.5;" alignment="TOP_LEFT"
      xmlns="http://javafx.com/javafx/8.0.201" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.murong.ecp.tools.fx.controller.PaneExeRecordController">
    <GridPane hgap="10" vgap="10">
        <!-- 第一行：环境、Schema -->
        <Label text="环境:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
        <ComboBox fx:id="envComboBox" promptText="请选择环境" prefWidth="150" GridPane.rowIndex="0" GridPane.columnIndex="1" />
        <Label text="Schema:" GridPane.rowIndex="0" GridPane.columnIndex="2" />
        <ComboBox fx:id="schemaComboBox" promptText="请选择Schema" prefWidth="150" GridPane.rowIndex="0" GridPane.columnIndex="3" />
        <!-- 第二行：开始、结束日期、查询按钮 -->
        <Label text="开始日期:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
        <DatePicker fx:id="startDatePicker" prefWidth="150" GridPane.rowIndex="1" GridPane.columnIndex="1" />
        <Label text="结束日期:" GridPane.rowIndex="1" GridPane.columnIndex="2" />
        <DatePicker fx:id="endDatePicker" prefWidth="150" GridPane.rowIndex="1" GridPane.columnIndex="3" />
        <Label text="关键字:" GridPane.rowIndex="1" GridPane.columnIndex="4" />
        <TextField fx:id="keywordTextField" promptText="请输入关键字" prefWidth="150" GridPane.rowIndex="1" GridPane.columnIndex="5" />
        <Button fx:id="queryButton" text="查询" GridPane.rowIndex="1" GridPane.columnIndex="6" />
    </GridPane>
    <TableView fx:id="tableView" VBox.vgrow="ALWAYS" prefHeight="400" prefWidth="900">
        <columns>
            <TableColumn fx:id="checkCol" prefWidth="40" />
            <TableColumn fx:id="envNameColumn" text="环境" />
            <TableColumn fx:id="exeDateColumn" text="执行日期" />
            <TableColumn fx:id="exeTimeColumn" text="执行时间" />
            <TableColumn fx:id="schemaNmColumn" text="SCHEMA" />
            <TableColumn fx:id="exeSqlColumn" text="执行SQL" prefWidth="300"/>
            <TableColumn fx:id="statusColumn" text="执行状态" prefWidth="90" />
            <TableColumn fx:id="updateByColumn" text="更执行人" />
            <TableColumn fx:id="opCol" text="操作" prefWidth="80" />
        </columns>
    </TableView>
</VBox> 