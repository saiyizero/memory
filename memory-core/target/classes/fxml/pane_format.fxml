<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/8.0.201" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.murong.ecp.tools.fx.controller.PaneFormatController" alignment="CENTER" spacing="20.0" prefWidth="800.0" prefHeight="600.0" style="-fx-background-color: white;">
    <children>
        <TextArea fx:id="xmlInput" promptText="请输入XML报文..." prefWidth="700.0" prefHeight="400.0" wrapText="true" />
        <HBox alignment="CENTER" spacing="15.0">
            <Button fx:id="formatBtn" text="格式化" minWidth="100.0" />
            <Button fx:id="removeNewlineBtn" text="去换行符" minWidth="100.0" />
            <Button fx:id="removeSpaceBtn" text="去空格" minWidth="100.0" />
        </HBox>
        <HBox alignment="CENTER" spacing="10.0">
            <TextField fx:id="replaceInput" promptText="输入要替换的内容,格式：原文->新文" prefWidth="400.0" />
            <Button fx:id="replaceBtn" text="替换" minWidth="80.0" />
        </HBox>
    </children>
</VBox> 