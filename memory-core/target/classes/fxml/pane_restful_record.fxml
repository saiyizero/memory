<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<SplitPane dividerPositions="0.52" xmlns="http://javafx.com/javafx/8.0.201" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.murong.ecp.tools.fx.controller.PanRestFulRecordController"
           prefWidth="900.0" prefHeight="600.0">
    <items>
        <!-- 左侧汇总区域 -->
        <VBox spacing="10" style="-fx-padding: 10;" alignment="TOP_LEFT">
            <!-- 日期选择区域 -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="开始:"/>
                <DatePicker fx:id="startDatePicker" promptText="选择开始日期"/>
                <Label text="结束:"/>
                <DatePicker fx:id="endDatePicker" promptText="选择结束日期"/>
                <Button fx:id="clearButton" text="查询"/>
            </HBox>
            
            <TableView fx:id="summaryTableView" VBox.vgrow="ALWAYS" editable="true">
                <columns>
                    <TableColumn fx:id="summaryTestCol" text="测试" prefWidth="40" resizable="false"/>
                    <TableColumn fx:id="interfaceNameColumn" text="接口URL" prefWidth="150"/>
                    <TableColumn fx:id="transNameColumn" text="交易名" prefWidth="130"/>
                    <TableColumn fx:id="transDescColumn" text="交易描述" prefWidth="180"/>
                </columns>
            </TableView>
        </VBox>
        
        <!-- 右侧查询区域 -->
        <VBox spacing="10" style="-fx-padding: 10;">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="IP:"/>
                <ComboBox fx:id="ipComboBox" promptText="选择IP" prefWidth="120"/>
                <Label text="关键字:"/>
                <TextField fx:id="keywordTextField" promptText="输入关键字搜索" prefWidth="150"/>
                <Button fx:id="queryButton" text="查询"/>
            </HBox>
            
            <!-- 状态信息 -->
            <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 5;">
                <Label fx:id="statusLabel" text="请选择左侧汇总项查看详细记录"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="recordCountLabel" text="记录数: 0"/>
            </HBox>
            
            <!-- 右侧表格区域 -->
            <TableView fx:id="detailTableView" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="detailUpdateTimeColumn" text="测试时间" prefWidth="80"/>
                    <TableColumn fx:id="detailIpColumn" text="IP地址" prefWidth="80"/>
                    <TableColumn fx:id="detailMsgCodeColumn" text="消息码" prefWidth="80"/>
                    <TableColumn fx:id="detailMsgInfColumn" text="消息信息" prefWidth="100"/>
                    <TableColumn fx:id="detailRemarkColumn" text="备注信息" prefWidth="120"/>
                </columns>
            </TableView>
        </VBox>
    </items>
</SplitPane> 