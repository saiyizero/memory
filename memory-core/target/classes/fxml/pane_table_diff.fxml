<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.murong.ecp.tools.fx.controller.PaneTableDiffController"
      spacing="10" styleClass="pane-container">
    
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>
    
    <!-- 查询条件区域 -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="表名:"/>
        <TextField fx:id="tableNameField" promptText="输入表名" prefWidth="200"/>
        <Label text="环境:"/>
        <ComboBox fx:id="envComboBox" prefWidth="100"/>
        <Label text="差异类型:"/>
        <ComboBox fx:id="diffTypeComboBox" prefWidth="120"/>
        <Button fx:id="queryButton" text="查询" onAction="#queryDiffRecords"/>
        <Button fx:id="clearButton" text="清空" onAction="#clearQuery"/>
    </HBox>
    
    <!-- 差异记录表格 -->
    <TableView fx:id="diffTableView" VBox.vgrow="ALWAYS" >
        <columns>
            <TableColumn fx:id="compareEnvColumn" text="环境" prefWidth="50"/>
            <TableColumn fx:id="tableNameColumn" text="表名" prefWidth="140"/>
            <TableColumn fx:id="diffFieldCountColumn" text="差异数量" prefWidth="60"/>
            <TableColumn fx:id="localValueColumn" text="本地值" prefWidth="150"/>
            <TableColumn fx:id="remoteValueColumn" text="远程值" prefWidth="150"/>
            <TableColumn fx:id="diffTypeColumn" text="差异类型" prefWidth="100"/>
            <TableColumn fx:id="actionColumn" text="操作" prefWidth="80"/>
        </columns>
    </TableView>
    
</VBox> 